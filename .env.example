# Where the app reads its data from:
#   code      the generated fake data in src/data/mockData.ts (default)
#   supabase  the same data, loaded from the Supabase database
# Restart the dev server after changing this.
VITE_DATA_SOURCE=code

# Only needed when VITE_DATA_SOURCE=supabase.
# Fill in from Supabase: Project Settings > API.
# Both values are safe to ship in the browser; never put the secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
